# Local PilotDeck ports for scripts/start-local.sh and scripts/stop-local.sh.
# Change values here, then restart. Shell environment still wins if already set.

SERVER_PORT=3020
# 18789 is held by another user's leftover process on this box.
PILOTDECK_GATEWAY_PORT=18800
VITE_PORT=5170

# Office preview/rendering is centralized on node12. Override per deployment.
PILOTDECK_OFFICE_RENDERER_ROLE=remote
PILOTDECK_OFFICE_RENDERER_PORT=19400
PILOTDECK_OFFICE_RENDERER_URL=http://10.31.112.13:19400

# CLI/TUI 在免登录模式下自动使用 <PILOT_HOME>/users/<admin>/；多用户部署不要暴露 CLI。
