# Copy to a private node12 deployment directory and load as plain KEY=VALUE lines.
# MinerU uses the node12 internal network boundary; no API token is required.
MINERU_SERVICE_ROOT=/local_data/huojianfan/mineru-service
MED_RAG_MINERU_LAUNCHER='"/local_data/medical/Med-Rag/UltraRAG/.venv/bin/python" -m mineru.cli.client'
MED_RAG_MINERU_MODEL_ROOT=/local_data/models/opendatalab/PDF-Extract-Kit-1___0
MED_RAG_MINERU_DEFAULT_DEVICE=cuda
MED_RAG_MINERU_MAX_WORKERS=1
MINERU_SERVICE_BIND=node12
MINERU_SERVICE_PORT=18890
MINERU_SERVICE_MAX_UPLOAD_BYTES=52428800
MINERU_SERVICE_MAX_JOBS=1
MINERU_SERVICE_JOB_TIMEOUT=3600
MINERU_SERVICE_RETENTION_SECONDS=3600
