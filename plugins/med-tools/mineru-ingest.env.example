# Copy this file outside Git, preferably to:
#   $PILOT_HOME/med-tools/mineru-ingest.env
#
# It is loaded by both run-mineru-ingest.sh (stdio) and
# run-mineru-ingest-http.sh (optional HTTP service). Do not put tokens, model
# files, or machine-specific values in plugin.json or Git.

MED_RAG_MINERU_LAUNCHER='"/path/to/python" -m mineru.cli.client'
MED_RAG_MINERU_MODEL_ROOT='/path/to/mineru-pipeline-models'
MED_RAG_MINERU_INGEST_ROOT='/path/on/data-disk/mineru-ingest'
MED_RAG_MINERU_DEFAULT_CPU_THREADS='8'
MED_RAG_MINERU_MAX_WORKERS='1'
