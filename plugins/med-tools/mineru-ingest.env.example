# Copy to $PILOT_HOME/med-tools/mineru-ingest.env.
# This file is parsed as plain KEY=VALUE lines; shell code is not executed.
MED_RAG_MINERU_LAUNCHER='"/path/to/python" -m mineru.cli.client'
MED_RAG_MINERU_MODEL_ROOT='/path/to/mineru-pipeline-models'
# Optional; when omitted the service uses:
#   <PILOT_HOME>/med-tools/mineru-ingest
# MED_RAG_MINERU_INGEST_ROOT='/absolute/path/inside/PILOT_HOME/med-tools/mineru-ingest'
MED_RAG_MINERU_DEFAULT_CPU_THREADS='8'
MED_RAG_MINERU_MAX_WORKERS='1'
# local keeps the existing stdio MCP and local runtime behavior.
# remote uploads document bytes to the node12 HTTP service.
MED_RAG_MINERU_REMOTE_MODE='local'
MED_RAG_MINERU_API_BASE=''
MED_RAG_MINERU_API_TOKEN_FILE=''
MED_RAG_MINERU_CA_BUNDLE=''
MED_RAG_MINERU_CONNECT_TIMEOUT='10'
MED_RAG_MINERU_POLL_INTERVAL='2'
MED_RAG_MINERU_MAX_UPLOAD_BYTES=''
