# 服务端：复制到独立部署目录，chmod 600。客户端配置见 config/deploy.env.example。
MED_DEEPCHEST_ROOT=/absolute/path/to/3D-MLLM
DEEPCHEST_WORK_ROOT=/absolute/path/to/deepchest-jobs
DEEPCHEST_API_KEY_FILE=/absolute/path/to/deepchest-api-key
DEEPCHEST_GPU=0
DEEPCHEST_JOB_TIMEOUT=1800
DEEPCHEST_RETENTION_SECONDS=86400
FINAL_TEST_OPENAI_BASE_URL=http://127.0.0.1:8040/v1
FINAL_TEST_OPENAI_MODEL=Qwen3.8-27B
# Qwen/vLLM 支持此开关时使用 0；其他服务设 auto，不传该扩展参数。
DEEPCHEST_ENABLE_THINKING=0
DEEPCHEST_ANSWER_READ_TIMEOUT=300
# OPENAI_API_KEY=配置实际模型鉴权，若模型服务需要
PYTHONNOUSERSITE=1
