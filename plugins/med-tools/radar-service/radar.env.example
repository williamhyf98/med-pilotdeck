# Copy to /local_data/radar-service/radar.env, chmod 600, and replace the key.
CUDA_VISIBLE_DEVICES=4
RADAR_DEVICE=cuda:0
RADAR_SERVICE_ROOT=/local_data/radar-service
RADAR_ROOT=/local_data/radar-service/damo-radar
RADAR_MODEL_ROOT=/local_data/radar-service/models
RADAR_TEXT_EMBEDDING=/local_data/radar-service/damo-radar/ckpt/infer_text_embedding_radar.pt
RADAR_WORK_ROOT=/local_data/radar-service/work
RADAR_API_KEY=replace-with-a-random-secret
RADAR_MAX_UPLOAD_BYTES=8589934592
RADAR_MAX_MULTIPART_OVERHEAD_BYTES=1048576
RADAR_MAX_ARCHIVE_MEMBERS=20000
RADAR_MAX_NIFTI_VOXELS=536870912
RADAR_MAX_NIFTI_DECODED_BYTES=4294967296
RADAR_MAX_RESAMPLED_VOXELS=268435456
RADAR_MAX_RESAMPLED_BYTES=2147483648
RADAR_MAX_GPU_WORKING_BYTES=25769803776
RADAR_RETENTION_SECONDS=3600
RADAR_CLEANUP_INTERVAL_SECONDS=600
RADAR_MODEL_RETRY_SECONDS=60
TMPDIR=/local_data/radar-service/tmp
HF_HOME=/local_data/radar-service/cache/huggingface
MPLCONFIGDIR=/local_data/radar-service/cache/matplotlib
PYTHONDONTWRITEBYTECODE=1
TOKENIZERS_PARALLELISM=false
