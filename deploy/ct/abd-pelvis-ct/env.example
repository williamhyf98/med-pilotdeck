ABD_PELVIS_CT_TAG=dev
ABD_PELVIS_CT_GPU=0
ABD_PELVIS_CT_DEVICE=cuda:0
ABD_PELVIS_CT_INFERENCE_WORK_ROOT=/var/lib/abd-pelvis-ct/inference
ABD_PELVIS_CT_GATEWAY_WORK_ROOT=/var/lib/abd-pelvis-ct/gateway

# 宿主端口发布。默认只给本机用；主系统在另一台机器时把网关发布地址改成本机内网 IP，
# 例如 ABD_PELVIS_CT_GATEWAY_PUBLISH_HOST=10.31.112.13，端口保持 18120 即可让
# med-tools 的 MED_RADAR_API_BASE 沿用原值。
ABD_PELVIS_CT_GATEWAY_PUBLISH_HOST=127.0.0.1
ABD_PELVIS_CT_GATEWAY_PUBLISH_PORT=18120
ABD_PELVIS_CT_INFERENCE_PUBLISH_HOST=127.0.0.1
ABD_PELVIS_CT_INFERENCE_PUBLISH_PORT=18221
